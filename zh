#!/usr/bin/env bash
# zh — ZenHub CLI launcher (Python + uv)
set -euo pipefail

# resolve symlinks so ~/.local/bin/zh -> repo/zh still cds into the checkout
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
cd "$ROOT"

# clear direnv/sibling-workspace uv+venv vars; else uv run may use a foreign
# UV_PROJECT_ENVIRONMENT and fail with ModuleNotFoundError (click, typer, …)
unset VIRTUAL_ENV
unset UV_PROJECT
unset UV_WORKSPACE
unset UV_PROJECT_ENVIRONMENT
unset PYTHONPATH

if command -v uv >/dev/null 2>&1; then
  # --project pins this checkout; python -m zh (not `uv run zh`) avoids re-exec loop
  exec uv run --project "$ROOT" python -m zh "$@"
fi

# no uv: run from src/
export PYTHONPATH="${ROOT}/src"
exec python3 -m zh "$@"
